[Unit]
Description=Kahya web panel
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=pi
WorkingDirectory=/home/pi/kahya
EnvironmentFile=/home/pi/kahya/.env
ExecStart=/usr/bin/python3 -m kahya.server
Restart=on-failure
RestartSec=10

[Install]
WantedBy=multi-user.target
