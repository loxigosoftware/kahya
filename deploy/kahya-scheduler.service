# Kahya systemd units — Raspberry Pi / any Linux box.
#
# Install:
#   sudo cp deploy/kahya-*.service /etc/systemd/system/
#   sudo systemctl daemon-reload
#   sudo systemctl enable --now kahya-scheduler kahya-bot kahya-web
#
# The EnvironmentFile points at the repo's .env (see .env.example).
# Adjust User/WorkingDirectory for your setup.
[Unit]
Description=Kahya scheduler (reminder engine)
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=pi
WorkingDirectory=/home/pi/kahya
EnvironmentFile=/home/pi/kahya/.env
ExecStart=/usr/bin/python3 -m kahya.scheduler
Restart=on-failure
RestartSec=10

[Install]
WantedBy=multi-user.target
