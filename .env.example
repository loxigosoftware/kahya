# Kahya configuration — copy to .env and fill in.
# Every value can also be set as a real environment variable (wins over .env).

# --- LLM: any OpenAI-compatible endpoint, or Anthropic ---
# Local Ollama on your LAN (e.g. the Mac in the living room):
#   BASE_URL=http://192.168.1.50:11434/v1   API_KEY= (empty)
#   AMELE_MODEL=qwen3-vl:8b
# Cloud:
#   BASE_URL=https://api.openai.com/v1      API_KEY=sk-...
#   AMELE_MODEL=gpt-4.1-mini
#   BASE_URL=https://openrouter.ai/api/v1   API_KEY=sk-or-...
PROVIDER_TYPE=openai
BASE_URL=http://192.168.1.50:11434/v1
API_KEY=
AMELE_MODEL=qwen3-vl:8b

# --- Telegram ---
# Create a bot with @BotFather, then message it once and read your chat id
# from the bot API (or use @userinfobot).
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# --- paths (defaults are fine) ---
# AMELE_BIN=./bin/amele
# KAHYA_DB=./data/kahya.db
# KAHYA_WEB_PORT=8080
# KAHYA_TIMEZONE=Europe/Istanbul
